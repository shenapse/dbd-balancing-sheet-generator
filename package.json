{
  "name": "balancing-sheet-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Generates Dead by Daylight balancing sheets (perks, add-ons, items, builds) as PNGs",
  "type": "module",
  "bin": {
    "dbd-sheet": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "js-yaml": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
